@media (max-width: 1200px) {
  .ParaVideo {
	  width: 100%;
	  height:100vh;
    /* padding: 15px 0px; */
  } 
  .ParaVideo > video {
    position: absolute;

    width: 100%;
    height: 34%;

    top: 50%;
    left: 50%;
    object-fit: cover;
    transform: translate(-50%, -50%);
    margin-block: 0;
    display: block;
  }
}

#home {
  position: relative;
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
}

.home-slider {
  position: relative;
}
.home-slider .swiper-slide {
  padding: 250px 0 180px 0;
}
.home-subtitle {
  font-weight: 700;
  letter-spacing: 6px;
  text-transform: uppercase;
  font-size: 15px;
}

.bg-overlay {
  position: absolute;
  background-color: rgba(48, 58, 69, 0.7);
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
}