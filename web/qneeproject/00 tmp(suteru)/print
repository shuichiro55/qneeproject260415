#home {
  position: relative;
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  
.home-slider {
  position: relative;
}

.home-slider .swiper-slide {
  padding: 250px 0 180px 0;
}

.home-subtitle {
  font-weight: 700;
  letter-spacing: 6px;
  text-transform: uppercase;
  font-size: 15px;
}

.bg-overlay {
  position: absolute;
  background-color: rgba(48, 58, 69, 0.7);
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
}